# The Thinking Gym — AI feedback endpoint (api/feedback.js) environment.
# Copy to `.env` where the server function runs. NEVER commit real keys, and note
# these belong to the SERVER only — the browser app never sees them (brief §17).

# Required: your Anthropic API key. Server-side only.
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional: model to use. Swappable per §17. Defaults to claude-opus-5.
# AI_MODEL=claude-opus-5

# Optional: restrict CORS to your app's origin in production (defaults to *).
# AI_ALLOW_ORIGIN=https://your-app.example.com
